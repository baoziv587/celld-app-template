{
  "name": "notes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MAX_NOTES_PER_BOARD": "200"
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARDS", "class_name": "BoardCell" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardCell"] }]
}
