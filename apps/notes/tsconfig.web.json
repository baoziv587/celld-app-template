{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client"],
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./node_modules/.cache/tsc/web"
  },
  "include": ["src", "shared", "vite.config.ts"]
}
