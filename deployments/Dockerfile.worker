# One Dockerfile for every worker. Build context is the repo root:
#   docker build -f deployments/Dockerfile.worker --build-arg WORKER=counter \
#     --build-arg CELLD_IMAGE=... .
# The image is a one-shot deployer: it holds the built worker plus the celld
# CLI, and its entrypoint publishes the worker into the fleet bucket.
ARG CELLD_IMAGE=ghcr.io/denoland/celld:managed-by-deployments-versions-env
FROM ${CELLD_IMAGE} AS celld

FROM node:24-bookworm-slim AS build
ARG WORKER
RUN test -n "$WORKER" || (echo "build-arg WORKER is required" >&2 && exit 1)
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1
RUN corepack enable
WORKDIR /repo

# Manifests first, so the dependency layer survives source edits.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY apps/${WORKER}/package.json ./apps/${WORKER}/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "${WORKER}..."

COPY tsconfig.base.json ./
COPY apps/${WORKER} ./apps/${WORKER}
RUN pnpm --filter "${WORKER}..." --if-present typecheck \
    && pnpm --filter "${WORKER}" --if-present build

FROM node:24-bookworm-slim
ARG WORKER
# celld deploy bundles the worker with the esbuild it finds on PATH.
RUN npm install --global esbuild@0.28.2 && npm cache clean --force
COPY --from=celld /usr/local/bin/celld /usr/local/bin/celld
COPY --from=build /repo /repo
COPY deployments/worker-entrypoint.mjs /usr/local/bin/worker-entrypoint.mjs
WORKDIR /repo/apps/${WORKER}
ENTRYPOINT ["node", "/usr/local/bin/worker-entrypoint.mjs"]
