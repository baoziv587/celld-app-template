# Where `pnpm manage deploy` publishes. Copy to deploy.env (gitignored).
# These must be the same bucket and endpoint the cluster's fleets read.

# Fleet bucket root; each worker goes to <BUCKET_ROOT>/<worker>.
BUCKET_ROOT=s3://cells
# S3 endpoint as reachable from this machine. For the in-cluster RustFS:
#   kubectl -n cells port-forward svc/rustfs 19200:9000
S3_ENDPOINT=http://127.0.0.1:19200
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
