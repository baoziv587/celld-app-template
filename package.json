{
  "name": "celld-app-template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:infra",
    "check:infra": "./deployments/check-infra.sh",
    "new:worker": "tsx scripts/create-worker.ts",
    "stack:up": "docker compose --profile all up --build --remove-orphans",
    "stack:down": "docker compose --profile all down",
    "deploy:worker": "tsx scripts/deploy-worker.ts",
    "k8s:apply": "kubectl apply -k deployments/k8s",
    "k8s:diff": "kubectl diff -k deployments/k8s"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@clack/prompts": "^1.8.1",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@eslint-react/eslint-plugin": "^5.20.5",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-slop": "^0.1.3",
    "jiti": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
